# The Phase 1 prototype (index.html) needs NO environment variables.
# These are for Phase 2 (live data). Copy to .env and fill in. Never commit .env.

# Firebase project used for offline-first counter sync (Phase 2)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Alerts to administration (Phase 2, optional)
CELL_BROADCAST_GATEWAY_URL=
